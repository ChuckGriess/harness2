# Harness2 environment template. Copy to .env (git-ignored) and fill in what you use:
#
#     cp .env.example .env
#
# Shell variables override .env. An empty value counts as unset, so the defaults noted below
# apply. Keep secrets out of every other file: .env is never committed and never enters the
# Docker image (it is read at run time through docker/compose.yaml's env_file).

# ============================================================================================
# AI RADAR (Claude API research agent): the `radar` benchmark, harness2-radar, docker/
# ============================================================================================

# --- Required --------------------------------------------------------------------------------

# Claude API key for the agent, the improver and the judge (console.anthropic.com).
ANTHROPIC_API_KEY=

# Where gold lists live (<dir>/<week>/<topic>/gold.json). Required to judge or run sweeps;
# not needed for harness2-radar digests. Must be OUTSIDE this repository, e.g. ~/radar-gold.
# Inside docker it is always /gold (set HARNESS2_RADAR_GOLD_HOST_DIR in your shell instead).
HARNESS2_RADAR_GOLD_DIR=

# --- Optional: models, effort and spend caps (defaults shown) --------------------------------

# Agent model. Default claude-sonnet-5-5.
HARNESS2_CA_MODEL=
# Improver model for the claude_api channel. Default: HARNESS2_CA_MODEL.
HARNESS2_CA_IMPROVER_MODEL=
# Agent effort: low | medium | high | xhigh | max. Default medium.
HARNESS2_CA_EFFORT=
# Per-rollout caps. Defaults: 60 turns, 300 cents, 20 web searches.
HARNESS2_CA_MAX_TURNS=
HARNESS2_CA_MAX_USD_CENTS=
HARNESS2_CA_MAX_SEARCHES=
# Per-improver-session cost cap. Default 500 cents.
HARNESS2_CA_IMPROVER_MAX_USD_CENTS=

# --- Optional: delivery (used only with harness2-radar --deliver) ----------------------------

# Slack incoming-webhook URL, for --deliver slack.
HARNESS2_RADAR_SLACK_WEBHOOK=

# Email over SMTP with TLS, for --deliver email. All but the port are required for email.
# The docker sandbox has no SMTP egress: send email from the host with
#   harness2-radar --send <digest.md> --deliver email
HARNESS2_RADAR_SMTP_HOST=
# Default 465.
HARNESS2_RADAR_SMTP_PORT=
HARNESS2_RADAR_SMTP_USER=
HARNESS2_RADAR_SMTP_PASSWORD=
HARNESS2_RADAR_EMAIL_FROM=
HARNESS2_RADAR_EMAIL_TO=

# --- Docker compose: set these in your SHELL, not here --------------------------------------
# Compose reads them when it builds the stack; it does not read this file for them.
#   HARNESS2_RADAR_GOLD_HOST_DIR=~/radar-gold          host gold dir, mounted read-only at /gold
#   RADAR_DELIVERY_ALLOWLIST=./proxy/delivery.txt      let the proxy reach hooks.slack.com

# ============================================================================================
# SHARED
# ============================================================================================

# Output root for all runs. Default runs/ in the repository (git-ignored). Use a fresh value
# when you change a model or task selection; the saved configuration blocks mixed resumes.
HARNESS2_RUNS_DIR=

# Judge model. For the radar benchmark leave it EMPTY to judge with HARNESS2_CA_MODEL; a
# value here (e.g. a Gemini id for the upstream benchmarks) becomes the radar judge too.
HARNESS2_JUDGE_MODEL=

# ============================================================================================
# UPSTREAM BENCHMARKS (JobBench, LAB, WorkBuddy on OpenCode / Codex via Vertex AI)
# Not needed for AI Radar. See docs/SETUP.md#models-and-credentials.
# ============================================================================================

# Vertex AI project and location. Authenticate with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
# Default global.
GOOGLE_CLOUD_LOCATION=
# Only for a service-account key file instead of Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# Executor model in OpenCode provider/model form, e.g. google-vertex/<model>.
HARNESS2_SOLVER_MODEL=
# Improver model in the same form. Default: HARNESS2_SOLVER_MODEL.
HARNESS2_IMPROVER_MODEL=

# JobBench judge endpoint and key, for a non-Gemini judge (OpenAI-compatible).
HARNESS2_JUDGE_BASE_URL=
HARNESS2_JUDGE_API_KEY=

# Codex executor (--substrate cx). harness2-bridge prints the URL and key to use.
HARNESS2_CODEX_MODEL=
HARNESS2_CODEX_BASE_URL=
HARNESS2_CODEX_CONTAINER_URL=
HARNESS2_CODEX_API_KEY=
